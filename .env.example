# Required for setup-account and live trading.
PRIVATE_KEY=

# Required for live trading. `polycopy auth init` can create or derive these.
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=

# Required for POLY_1271 setup-account --execute when deployment or approvals are needed.
# Use either relayer API key auth:
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=

# Or builder auth:
POLY_BUILDER_API_KEY=
POLY_BUILDER_SECRET=
POLY_BUILDER_PASS_PHRASE=

# Optional local path overrides.
POLYCOPY_DATA_DIR=
POLYCOPY_DB_PATH=
POLYCOPY_LOG_DIR=
KILL_SWITCH_PATH=
